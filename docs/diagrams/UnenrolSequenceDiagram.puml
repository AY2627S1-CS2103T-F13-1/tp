@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":UnenrolCommandParser" as UnenrolCommandParser LOGIC_COLOR
participant "u:UnenrolCommand" as UnenrolCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "ab:AddressBook" as AddressBook MODEL_COLOR
end box

[-> LogicManager : execute("unenrol s/1 l/2")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("unenrol s/1 l/2")
activate AddressBookParser

create UnenrolCommandParser
AddressBookParser -> UnenrolCommandParser
activate UnenrolCommandParser

UnenrolCommandParser --> AddressBookParser
deactivate UnenrolCommandParser

AddressBookParser -> UnenrolCommandParser : parse(" s/1 l/2")
activate UnenrolCommandParser

create UnenrolCommand
UnenrolCommandParser -> UnenrolCommand
activate UnenrolCommand

UnenrolCommand --> UnenrolCommandParser :
deactivate UnenrolCommand

UnenrolCommandParser --> AddressBookParser : u
deactivate UnenrolCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
UnenrolCommandParser -[hidden]-> AddressBookParser
destroy UnenrolCommandParser

AddressBookParser --> LogicManager : u
deactivate AddressBookParser

LogicManager -> UnenrolCommand : execute(m)
activate UnenrolCommand

UnenrolCommand -> Model : getAddressBook()
activate Model

Model --> UnenrolCommand : ab
deactivate Model

UnenrolCommand -> AddressBook : isEnrolled(s, l)
activate AddressBook

AddressBook --> UnenrolCommand : true
deactivate AddressBook

UnenrolCommand -> Model : unenrolStudent(s, l)
activate Model

Model -> AddressBook : removeEnrolment(e)
activate AddressBook

AddressBook --> Model
deactivate AddressBook

Model --> UnenrolCommand
deactivate Model

create CommandResult
UnenrolCommand -> CommandResult
activate CommandResult

CommandResult --> UnenrolCommand
deactivate CommandResult

UnenrolCommand --> LogicManager : r
deactivate UnenrolCommand

[<--LogicManager
deactivate LogicManager
@enduml
