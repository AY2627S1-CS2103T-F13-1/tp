@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant "d:DeleteLessonCommand" as DeleteLessonCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

activate LogicManager
LogicManager -> DeleteLessonCommand : execute(m)
activate DeleteLessonCommand

DeleteLessonCommand -> Model : getFilteredLessonList()
activate Model
Model --> DeleteLessonCommand : displayed lessons
deactivate Model

note right of DeleteLessonCommand
  An index beyond the displayed list is
  rejected here with a CommandException.
end note

DeleteLessonCommand -> Model : getAddressBook()
activate Model
Model --> DeleteLessonCommand
deactivate Model

DeleteLessonCommand -> AddressBook : getStudentsInLesson(lesson)
activate AddressBook
AddressBook --> DeleteLessonCommand : enrolled students
deactivate AddressBook

DeleteLessonCommand -> Model : deleteLesson(lesson)
activate Model

Model -> AddressBook : removeLesson(lesson)
activate AddressBook
AddressBook -> AddressBook : remove the lesson's\nenrolments
activate AddressBook
deactivate AddressBook
AddressBook --> Model
deactivate AddressBook

opt student list shows only this lesson's students
    Model -> Model : show all students
    activate Model
    deactivate Model
end

Model --> DeleteLessonCommand
deactivate Model

create CommandResult
DeleteLessonCommand -> CommandResult : deleted lesson and\nunenrolled students
activate CommandResult
CommandResult --> DeleteLessonCommand
deactivate CommandResult

DeleteLessonCommand --> LogicManager : r
deactivate DeleteLessonCommand
deactivate LogicManager
@enduml
