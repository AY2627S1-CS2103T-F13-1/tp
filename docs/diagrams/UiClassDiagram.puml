@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class StudentListPanel
Class StudentCard
Class StudentCardDetails
Class LessonListPanel
Class LessonCard
Class LessonCardDetails
Class LessonUiFormatter
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
Class ReadOnlyAddressBook
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StudentListPanel
MainWindow *-down-> "1" LessonListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "0..1" HelpWindow

StudentListPanel -down-> "*" StudentCard
LessonListPanel -down-> "*" LessonCard
StudentCard ..> StudentCardDetails : formats student view
LessonCard ..> LessonCardDetails : formats lesson view
StudentCardDetails ..> LessonUiFormatter : formats memberships
LessonCardDetails ..> LessonUiFormatter : formats schedules
StudentListPanel ..> ReadOnlyAddressBook : reads memberships
LessonListPanel ..> ReadOnlyAddressBook : reads memberships
StudentListPanel ..> ReadOnlyAddressBook : listens for changes
LessonListPanel ..> ReadOnlyAddressBook : listens for changes

MainWindow -left-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
StudentListPanel --|> UiPart
StudentCard --|> UiPart
StudentCardDetails ..> HiddenModel
LessonListPanel --|> UiPart
LessonCard --|> UiPart
LessonCardDetails ..> HiddenModel
LessonUiFormatter ..> HiddenModel
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

StudentCard ..> Model
LessonCard ..> Model
UiManager -right-> Logic
MainWindow -left-> Logic

LessonListPanel -[hidden]left- HelpWindow
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter
StudentListPanel -[hidden]right- LessonListPanel

MainWindow -[hidden]-|> UiPart
@enduml
