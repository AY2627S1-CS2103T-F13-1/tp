@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF

Class Student {
id : UUID
}
Class Enrolment {
studentId : UUID
lessonId : UUID
}
Class Lesson {
id : UUID
}
show Student fields
show Enrolment fields
show Lesson fields

AddressBook *-right-> "*" Student
AddressBook *-right-> "*" Enrolment
AddressBook *-right-> "*" Lesson
Student -[hidden]down- Enrolment
Enrolment -[hidden]down- Lesson

Enrolment -up-> "1" Student
Enrolment -down-> "1" Lesson
@enduml
