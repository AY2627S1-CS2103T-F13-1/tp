@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedTutorBook" as VersionedTutorBook MODEL_COLOR
end box

[-> Model : undoTutorBook()
activate Model

Model -> VersionedTutorBook : undo()
activate VersionedTutorBook

VersionedTutorBook -> VersionedTutorBook :resetData(ReadOnlyTutorBook)
VersionedTutorBook --> Model :
deactivate VersionedTutorBook

[<-- Model
deactivate Model

@enduml
