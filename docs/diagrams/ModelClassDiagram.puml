@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyTutorBook" as ReadOnlyTutorBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class TutorBook
Class ModelManager
Class UserPrefs

Class UniqueStudentList
Class UniqueLessonList
Class Student
Class Guardian
Class Name
Class Phone
Class Lesson
Class LessonName
Class Day
Class Time

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

TutorBook .up.|> ReadOnlyTutorBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyTutorBook
ModelManager -left-> "1" TutorBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

TutorBook *--> "1" UniqueStudentList
TutorBook *--> "1" UniqueLessonList
UniqueStudentList --> "~* all" Student
UniqueLessonList --> "~* all" Lesson
Student *--> Name
Student *--> "0..1" Phone
Student *--> "0..1" Guardian
Student --> "*" Lesson
Guardian *--> Name
Guardian *--> Phone
Lesson *--> LessonName
Lesson *--> Day
Lesson *--> "2" Time

Student -[hidden]up--> I
UniqueStudentList -[hidden]right-> I

Name -[hidden]right-> Phone
LessonName -[hidden]right-> Day
Day -[hidden]right-> Time

ModelManager --> "~* filtered" Student
ModelManager --> "~* filtered" Lesson
@enduml
